# URL of the separated societyone-backend service
VITE_API_URL=http://localhost:3001

# Supabase project (used directly by some components for storage reads)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API key for the in-app AI assistant.
# NOTE: this ships in the client bundle and is publicly visible to anyone
# who opens devtools. Use a key restricted/rate-limited for browser use,
# or move the Gemini call to the backend if that's not acceptable for your
# use case. This mirrors the original app's behavior.
VITE_GEMINI_API_KEY=
